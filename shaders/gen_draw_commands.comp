#version 450

// GPU-Driven Draw Command Generation & Visibility Culling (Milestone 15).
// Combines Gribb-Hartmann camera Frustum Culling (Sphere + AABB) and
// conservative Hierarchical Depth (Hi-Z) Occlusion Culling.
// Main pass commands are culled; shadow pass commands preserve all shadow casters.

layout(local_size_x = 64) in;

struct GpuObjectData {
    mat4 model;
    vec4 albedoMetallic;
    vec4 roughnessAoTex;
    uvec4 meshInfo;          // x = mesh batch index, y = active flag
    vec4 boundingSphere;     // xyz = world center, w = world radius
    vec4 aabbMin;            // xyz = world AABB min, w = unused
    vec4 aabbMax;            // xyz = world AABB max, w = unused
};

struct MeshDrawInfo {
    uint indexCount;
    uint firstIndex;
    int  vertexOffset;
    uint pad;
};

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 0) readonly buffer ObjectBuffer {
    GpuObjectData objects[];
};

layout(std430, set = 0, binding = 1) readonly buffer MeshInfoBuffer {
    MeshDrawInfo meshes[];
};

layout(std430, set = 0, binding = 2) writeonly buffer MainCommandBuffer {
    DrawIndexedIndirectCommand mainCommands[];
};

layout(std430, set = 0, binding = 3) writeonly buffer ShadowCommandBuffer {
    DrawIndexedIndirectCommand shadowCommands[];
};

layout(set = 0, binding = 4) uniform CullingUBO {
    mat4 viewProj;
    mat4 prevViewProj;
    vec4 frustumPlanes[6]; // Left, Right, Bottom, Top, Near, Far
    vec4 cameraPos;
} culling;

layout(std430, set = 0, binding = 5) buffer CullingStatsBuffer {
    uint totalObjects;
    uint frustumCulled;
    uint occlusionCulled;
    uint finalVisible;
} stats;

layout(set = 0, binding = 6) uniform sampler2D uHiZMap;

layout(push_constant) uniform PushConstants {
    uint objectCount;
    uint meshCount;
    uint frustumCullingEnabled;
    uint occlusionCullingEnabled;
    uint hizValid;
    uint hizMipLevels;
    vec2 hizSize;
} pc;

void main() {
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= pc.objectCount) {
        return;
    }

    GpuObjectData obj = objects[slot];
    uvec4 info = obj.meshInfo;

    // Default culled command template
    DrawIndexedIndirectCommand zeroCmd;
    zeroCmd.indexCount    = 0u;
    zeroCmd.instanceCount = 1u;
    zeroCmd.firstIndex    = 0u;
    zeroCmd.vertexOffset  = 0;
    zeroCmd.firstInstance = slot;

    if (info.y == 0u || info.x >= pc.meshCount) {
        mainCommands[slot] = zeroCmd;
        shadowCommands[slot] = zeroCmd;
        return;
    }

    MeshDrawInfo mesh = meshes[info.x];

    // 1. Shadow Command: All active scene objects cast shadows without camera culling
    // to prevent any shadow caster dropping off-camera (Section 7 safety).
    DrawIndexedIndirectCommand shadowCmd;
    shadowCmd.indexCount    = mesh.indexCount;
    shadowCmd.instanceCount = 1u;
    shadowCmd.firstIndex    = mesh.firstIndex;
    shadowCmd.vertexOffset  = mesh.vertexOffset;
    shadowCmd.firstInstance = slot;
    shadowCommands[slot]    = shadowCmd;

    // 2. Camera Visibility Evaluation for Main Scene Pass
    bool visible = true;
    bool frustumCulled = false;
    bool occlusionCulled = false;

    // A. Frustum Culling
    if (pc.frustumCullingEnabled != 0u) {
        // Fast Sphere rejection against all 6 planes
        for (int i = 0; i < 6; ++i) {
            float dist = dot(culling.frustumPlanes[i].xyz, obj.boundingSphere.xyz) + culling.frustumPlanes[i].w;
            if (dist < -obj.boundingSphere.w) {
                visible = false;
                frustumCulled = true;
                break;
            }
        }

        // Tighter AABB rejection if sphere intersected
        if (visible) {
            for (int i = 0; i < 6; ++i) {
                vec3 n = culling.frustumPlanes[i].xyz;
                vec3 pVertex = vec3(
                    (n.x >= 0.0) ? obj.aabbMax.x : obj.aabbMin.x,
                    (n.y >= 0.0) ? obj.aabbMax.y : obj.aabbMin.y,
                    (n.z >= 0.0) ? obj.aabbMax.z : obj.aabbMin.z
                );
                if (dot(n, pVertex) + culling.frustumPlanes[i].w < 0.0) {
                    visible = false;
                    frustumCulled = true;
                    break;
                }
            }
        }
    }

    // B. Hi-Z Occlusion Culling
    if (visible && pc.occlusionCullingEnabled != 0u && pc.hizValid != 0u) {
        // Near plane safeguard: do not occlude objects intersecting or close to the near plane
        float nearDist = dot(culling.frustumPlanes[4].xyz, obj.boundingSphere.xyz) + culling.frustumPlanes[4].w;
        if (nearDist > (obj.boundingSphere.w + 0.15)) {
            vec3 corners[8];
            corners[0] = vec3(obj.aabbMin.x, obj.aabbMin.y, obj.aabbMin.z);
            corners[1] = vec3(obj.aabbMax.x, obj.aabbMin.y, obj.aabbMin.z);
            corners[2] = vec3(obj.aabbMin.x, obj.aabbMax.y, obj.aabbMin.z);
            corners[3] = vec3(obj.aabbMax.x, obj.aabbMax.y, obj.aabbMin.z);
            corners[4] = vec3(obj.aabbMin.x, obj.aabbMin.y, obj.aabbMax.z);
            corners[5] = vec3(obj.aabbMax.x, obj.aabbMin.y, obj.aabbMax.z);
            corners[6] = vec3(obj.aabbMin.x, obj.aabbMax.y, obj.aabbMax.z);
            corners[7] = vec3(obj.aabbMax.x, obj.aabbMax.y, obj.aabbMax.z);

            vec3 minNdc = vec3(1.0, 1.0, 1.0);
            vec3 maxNdc = vec3(-1.0, -1.0, 0.0);
            bool anyBehind = false;

            for (int i = 0; i < 8; ++i) {
                vec4 clip = culling.prevViewProj * vec4(corners[i], 1.0);
                if (clip.w <= 0.001) {
                    anyBehind = true;
                    break;
                }
                vec3 ndc = clip.xyz / clip.w;
                minNdc = min(minNdc, ndc);
                maxNdc = max(maxNdc, ndc);
            }

            if (!anyBehind) {
                vec2 minUV = clamp(minNdc.xy * 0.5 + 0.5, 0.0, 1.0);
                vec2 maxUV = clamp(maxNdc.xy * 0.5 + 0.5, 0.0, 1.0);
                float closestDepth = clamp(minNdc.z, 0.0, 1.0);

                vec2 sizeInTexels = (maxUV - minUV) * pc.hizSize;
                float maxDim = max(sizeInTexels.x, sizeInTexels.y);
                float mip = clamp(floor(log2(max(maxDim, 1.0))), 0.0, float(pc.hizMipLevels - 1));

                // Sample Hi-Z depth at the bounding box footprint corners
                float d00 = textureLod(uHiZMap, vec2(minUV.x, minUV.y), mip).r;
                float d10 = textureLod(uHiZMap, vec2(maxUV.x, minUV.y), mip).r;
                float d01 = textureLod(uHiZMap, vec2(minUV.x, maxUV.y), mip).r;
                float d11 = textureLod(uHiZMap, vec2(maxUV.x, maxUV.y), mip).r;
                float maxOccluderDepth = max(max(d00, d10), max(d01, d11));

                // Conservative depth bias prevents false occlusion from self-shadowing or precision limits
                if (closestDepth > (maxOccluderDepth + 0.0008)) {
                    visible = false;
                    occlusionCulled = true;
                }
            }
        }
    }

    // C. Statistics Gathering
    if (frustumCulled) {
        atomicAdd(stats.frustumCulled, 1u);
    } else if (occlusionCulled) {
        atomicAdd(stats.occlusionCulled, 1u);
    } else {
        atomicAdd(stats.finalVisible, 1u);
    }

    // D. Output Main Pass Indirect Command
    DrawIndexedIndirectCommand mainCmd;
    mainCmd.indexCount    = visible ? mesh.indexCount : 0u;
    mainCmd.instanceCount = 1u;
    mainCmd.firstIndex    = mesh.firstIndex;
    mainCmd.vertexOffset  = mesh.vertexOffset;
    mainCmd.firstInstance = slot;
    mainCommands[slot]    = mainCmd;
}
