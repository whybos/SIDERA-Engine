#version 450

// GPU-Driven Draw Command Generation, Instancing & Visibility Culling (Milestone 16).
// Combines Gribb-Hartmann camera Frustum Culling (Sphere + AABB) and
// conservative Hierarchical Depth (Hi-Z) Occlusion Culling.
// Batches instances so each (Mesh, Material) group is drawn with ONE instanced draw command.
// Main pass commands are culled & compacted; shadow pass commands preserve all shadow casters.

layout(local_size_x = 64) in;

struct GpuObjectData {
    mat4 model;
    vec4 albedoMetallic;
    vec4 roughnessAoTex;
    uvec4 meshInfo;          // x = batchId, y = active flag, z = instanceId, w = pad
    vec4 boundingSphere;     // xyz = world center, w = world radius
    vec4 aabbMin;            // xyz = world AABB min, w = unused
    vec4 aabbMax;            // xyz = world AABB max, w = unused
};

struct MeshDrawInfo {
    uint indexCount;
    uint firstIndex;
    int  vertexOffset;
    uint pad;
};

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

struct GpuBatchInfo {
    uint meshIndex;
    uint firstInstance;
    uint instanceCount;
    uint pad;
};

layout(std430, set = 0, binding = 0) readonly buffer ObjectBuffer {
    GpuObjectData objects[];
};

layout(std430, set = 0, binding = 1) readonly buffer MeshInfoBuffer {
    MeshDrawInfo meshes[];
};

layout(std430, set = 0, binding = 2) buffer MainCommandBuffer {
    DrawIndexedIndirectCommand mainCommands[];
};

layout(std430, set = 0, binding = 3) buffer ShadowCommandBuffer {
    DrawIndexedIndirectCommand shadowCommands[];
};

layout(set = 0, binding = 4) uniform CullingUBO {
    mat4 viewProj;
    mat4 prevViewProj;
    vec4 frustumPlanes[6]; // Left, Right, Bottom, Top, Near, Far
    vec4 cameraPos;
} culling;

layout(std430, set = 0, binding = 5) buffer CullingStatsBuffer {
    uint totalObjects;
    uint frustumCulled;
    uint occlusionCulled;
    uint finalVisible;
} stats;

layout(set = 0, binding = 6) uniform sampler2D uHiZMap;

layout(std430, set = 0, binding = 7) writeonly buffer VisibleIndicesBuffer {
    uint visibleIndices[];
};

layout(std430, set = 0, binding = 8) readonly buffer BatchInfoBuffer {
    GpuBatchInfo batches[];
};

layout(push_constant) uniform PushConstants {
    uint instanceCount;
    uint batchCount;
    uint frustumCullingEnabled;
    uint occlusionCullingEnabled;
    uint hizValid;
    uint hizMipLevels;
    vec2 hizSize;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.instanceCount) {
        return;
    }

    GpuObjectData obj = objects[idx];
    uvec4 info = obj.meshInfo;
    uint batchId = info.x;

    if (info.y == 0u || batchId >= pc.batchCount) {
        return;
    }

    GpuBatchInfo bInfo = batches[batchId];

    // Visibility determination
    bool visible = true;

    // 1. Camera Frustum Culling (Gribb-Hartmann normalized planes)
    if (pc.frustumCullingEnabled != 0u) {
        // Fast bounding sphere rejection test
        vec3 sphereCenter = obj.boundingSphere.xyz;
        float sphereRadius = obj.boundingSphere.w;
        for (int p = 0; p < 6; ++p) {
            vec3 n = culling.frustumPlanes[p].xyz;
            float d = culling.frustumPlanes[p].w;
            if (dot(n, sphereCenter) + d < -sphereRadius) {
                visible = false;
                break;
            }
        }

        // Conservative AABB test for surviving spheres
        if (visible) {
            vec3 bMin = obj.aabbMin.xyz;
            vec3 bMax = obj.aabbMax.xyz;
            for (int p = 0; p < 6; ++p) {
                vec3 n = culling.frustumPlanes[p].xyz;
                float d = culling.frustumPlanes[p].w;
                vec3 pVertex = vec3(
                    (n.x >= 0.0) ? bMax.x : bMin.x,
                    (n.y >= 0.0) ? bMax.y : bMin.y,
                    (n.z >= 0.0) ? bMax.z : bMin.z
                );
                if (dot(n, pVertex) + d < 0.0) {
                    visible = false;
                    break;
                }
            }
        }

        if (!visible) {
            atomicAdd(stats.frustumCulled, 1);
        }
    }

    // 2. Hierarchical Depth (Hi-Z) Occlusion Culling
    if (visible && pc.occlusionCullingEnabled != 0u && pc.hizValid != 0u) {
        vec3 bMin = obj.aabbMin.xyz;
        vec3 bMax = obj.aabbMax.xyz;

        vec3 corners[8] = vec3[8](
            vec3(bMin.x, bMin.y, bMin.z),
            vec3(bMax.x, bMin.y, bMin.z),
            vec3(bMin.x, bMax.y, bMin.z),
            vec3(bMax.x, bMax.y, bMin.z),
            vec3(bMin.x, bMin.y, bMax.z),
            vec3(bMax.x, bMin.y, bMax.z),
            vec3(bMin.x, bMax.y, bMax.z),
            vec3(bMax.x, bMax.y, bMax.z)
        );

        vec2 minClip = vec2(1.0);
        vec2 maxClip = vec2(-1.0);
        float minZ = 1.0;
        bool behindCamera = false;

        for (int i = 0; i < 8; ++i) {
            vec4 clip = culling.prevViewProj * vec4(corners[i], 1.0);
            if (clip.w <= 0.001) {
                behindCamera = true;
                break;
            }
            vec3 ndc = clip.xyz / clip.w;
            vec2 uv = ndc.xy * 0.5 + 0.5;
            minClip = min(minClip, uv);
            maxClip = max(maxClip, uv);
            minZ = min(minZ, ndc.z);
        }

        if (!behindCamera && minZ > 0.0 && minZ < 1.0) {
            vec2 boxSize = clamp(maxClip - minClip, vec2(0.0), vec2(1.0)) * pc.hizSize;
            float maxDim = max(boxSize.x, boxSize.y);
            float lod = clamp(ceil(log2(max(maxDim, 1.0))), 0.0, float(pc.hizMipLevels - 1));

            vec2 uv0 = clamp(minClip, vec2(0.0), vec2(1.0));
            vec2 uv1 = clamp(maxClip, vec2(0.0), vec2(1.0));

            float d0 = textureLod(uHiZMap, uv0, lod).r;
            float d1 = textureLod(uHiZMap, vec2(uv1.x, uv0.y), lod).r;
            float d2 = textureLod(uHiZMap, vec2(uv0.x, uv1.y), lod).r;
            float d3 = textureLod(uHiZMap, uv1, lod).r;

            float maxDepth = max(max(d0, d1), max(d2, d3));
            const float kDepthBias = 0.0005;
            if ((minZ - kDepthBias) > maxDepth) {
                visible = false;
                atomicAdd(stats.occlusionCulled, 1);
            }
        }
    }

    // 3. Compact visible instance into the batch's draw command
    if (visible) {
        uint localIdx = atomicAdd(mainCommands[batchId].instanceCount, 1);
        visibleIndices[bInfo.firstInstance + localIdx] = idx;
        atomicAdd(stats.finalVisible, 1);
    }
}
