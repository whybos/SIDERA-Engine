#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_preReflHdr;
layout(set = 0, binding = 1) uniform sampler2D u_depthTex;
layout(set = 0, binding = 2) uniform sampler2D u_hiZTex;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D u_rawSSR;

layout(set = 0, binding = 4) uniform ReflectionUBO {
    mat4 viewProj;
    mat4 invViewProj;
    mat4 prevViewProj;
    vec4 cameraPosNear;    // xyz = cameraPos, w = nearPlane
    vec4 rayParams;        // x = maxRayDistance, y = rayThickness, z = maxRoughness, w = farPlane
    vec4 blendParams;      // x = temporalBlend, y = reflectionIntensity, z = probeIntensity, w = confidenceThreshold
    uvec4 dims;            // x = ssrW, y = ssrH, z = fullW, w = fullH
    uvec4 counts;          // x = maxSteps, y = binarySteps, z = probeCount, w = flags
    uvec4 debugParams;     // x = debugMode, y = denoiseRadius, z = envMipCount, w = frameIndex
} u_ubo;

float linearizeDepth(float d, float n, float f) {
    return (n * f) / max(f - d * (f - n), 1e-4);
}

vec3 reconstructWorldPos(vec2 uv, float rawDepth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, rawDepth, 1.0);
    vec4 world = u_ubo.invViewProj * clip;
    return world.xyz / max(world.w, 1e-5);
}

vec3 reconstructNormalFromDepth(vec2 uv, vec2 invSize) {
    float dc = texture(u_depthTex, uv).r;
    float dx = texture(u_depthTex, uv + vec2(invSize.x, 0.0)).r;
    float dy = texture(u_depthTex, uv + vec2(0.0, invSize.y)).r;
    vec3 pc = reconstructWorldPos(uv, dc);
    vec3 px = reconstructWorldPos(uv + vec2(invSize.x, 0.0), dx);
    vec3 py = reconstructWorldPos(uv + vec2(0.0, invSize.y), dy);
    vec3 n = cross(px - pc, py - pc);
    float len = length(n);
    return (len > 1e-5) ? (n / len) : vec3(0.0, 1.0, 0.0);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(u_ubo.dims.x) || coord.y >= int(u_ubo.dims.y)) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(u_ubo.dims.xy);
    float rawDepth = texture(u_depthTex, uv).r;
    if (rawDepth >= 0.9999 || (u_ubo.counts.w & 4u) == 0u) {
        imageStore(u_rawSSR, coord, vec4(0.0));
        return;
    }

    vec2 invFull = 1.0 / vec2(u_ubo.dims.zw);
    vec3 worldPos = reconstructWorldPos(uv, rawDepth);
    vec3 normal = reconstructNormalFromDepth(uv, invFull);
    vec3 viewDir = normalize(u_ubo.cameraPosNear.xyz - worldPos);
    if (dot(normal, viewDir) < 0.0) normal = -normal;

    vec3 reflDir = normalize(reflect(-viewDir, normal));
    uint maxSteps = clamp(u_ubo.counts.x, 4u, 64u);
    uint binarySteps = clamp(u_ubo.counts.y, 1u, 8u);
    float maxDist = u_ubo.rayParams.x;
    float thickness = u_ubo.rayParams.y;
    float nearP = max(u_ubo.cameraPosNear.w, 0.05);
    float farP = max(u_ubo.rayParams.w, nearP + 1.0);

    vec3 rayOrigin = worldPos + normal * (thickness * 0.3);
    float stepSize = maxDist / float(maxSteps);

    bool hit = false;
    float hitT = 0.0;
    vec2 hitUV = vec2(0.0);

    for (uint s = 1u; s <= maxSteps; ++s) {
        float t = float(s) * stepSize;
        vec3 samplePos = rayOrigin + reflDir * t;
        vec4 clipPos = u_ubo.viewProj * vec4(samplePos, 1.0);
        if (clipPos.w <= 1e-4) break;
        vec3 ndc = clipPos.xyz / clipPos.w;
        vec2 sampleUV = ndc.xy * 0.5 + 0.5;
        if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0 || ndc.z < 0.0 || ndc.z > 1.0) {
            break;
        }

        // Coarse Hi-Z skip
        float hiZ = textureLod(u_hiZTex, sampleUV, 1.0).r;
        if (ndc.z < hiZ - 0.02) continue;

        float sceneDepth = texture(u_depthTex, sampleUV).r;
        float rayLin = linearizeDepth(ndc.z, nearP, farP);
        float sceneLin = linearizeDepth(sceneDepth, nearP, farP);
        float delta = rayLin - sceneLin;

        if (delta > 0.0 && delta < thickness) {
            // Binary search intersection refinement
            float tLo = t - stepSize;
            float tHi = t;
            for (uint b = 0u; b < binarySteps; ++b) {
                float tMid = 0.5 * (tLo + tHi);
                vec4 mClip = u_ubo.viewProj * vec4(rayOrigin + reflDir * tMid, 1.0);
                vec3 mNdc = mClip.xyz / max(mClip.w, 1e-5);
                vec2 mUV = mNdc.xy * 0.5 + 0.5;
                float mRayLin = linearizeDepth(mNdc.z, nearP, farP);
                float mSceneLin = linearizeDepth(texture(u_depthTex, mUV).r, nearP, farP);
                if (mRayLin > mSceneLin) {
                    tHi = tMid;
                    hitUV = mUV;
                } else {
                    tLo = tMid;
                }
            }
            hit = true;
            hitT = tHi;
            break;
        }
    }

    if (!hit) {
        imageStore(u_rawSSR, coord, vec4(0.0));
        return;
    }

    // Screen-edge and distance confidence fade
    vec2 edge = smoothstep(vec2(0.0), vec2(0.12), hitUV) * smoothstep(vec2(1.0), vec2(0.88), hitUV);
    float distFade = clamp(1.0 - (hitT / max(maxDist, 1.0)), 0.0, 1.0);
    float confidence = clamp(edge.x * edge.y * distFade, 0.0, 1.0);

    vec3 reflColor = min(texture(u_preReflHdr, hitUV).rgb, vec3(12.0));
    imageStore(u_rawSSR, coord, vec4(max(reflColor, vec3(0.0)), confidence));
}
