#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_rawGI;
layout(set = 0, binding = 1) uniform sampler2D u_prevHistory;
layout(set = 0, binding = 2) uniform sampler2D u_depthTex;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D u_currHistory;

layout(set = 0, binding = 4) uniform GIUniformBuffer {
    mat4 viewProj;
    mat4 invViewProj;
    mat4 prevViewProj;
    vec4 cameraPosNear;
    vec4 rayParams;
    vec4 temporalParams;
    uvec4 dims;
    uvec4 counts;
    uvec4 debugParams;
} u_ubo;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(u_ubo.dims.x) || coord.y >= int(u_ubo.dims.y)) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(u_ubo.dims.xy);
    vec4 curr = texture(u_rawGI, uv);
    bool histValid = (u_ubo.counts.w & 1u) != 0u;
    float blend = clamp(u_ubo.temporalParams.x, 0.0, 0.96);

    if (!histValid || blend <= 0.001) {
        imageStore(u_currHistory, coord, curr);
        return;
    }

    float rawDepth = texture(u_depthTex, uv).r;
    if (rawDepth >= 0.9999) {
        imageStore(u_currHistory, coord, vec4(0.0));
        return;
    }

    vec4 world = u_ubo.invViewProj * vec4(uv * 2.0 - 1.0, rawDepth, 1.0);
    vec3 worldPos = world.xyz / max(world.w, 1e-5);
    vec4 prevClip = u_ubo.prevViewProj * vec4(worldPos, 1.0);
    if (prevClip.w <= 1e-4) {
        imageStore(u_currHistory, coord, curr);
        return;
    }
    vec2 prevUV = (prevClip.xy / prevClip.w) * 0.5 + 0.5;
    if (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
        imageStore(u_currHistory, coord, curr);
        return;
    }

    // 3x3 neighborhood clamping to prevent ghosting & disocclusion leaks
    vec2 texel = 1.0 / vec2(u_ubo.dims.xy);
    vec4 nMin = curr;
    vec4 nMax = curr;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            vec4 s = texture(u_rawGI, uv + vec2(float(dx), float(dy)) * texel);
            nMin = min(nMin, s);
            nMax = max(nMax, s);
        }
    }

    vec4 prev = clamp(texture(u_prevHistory, prevUV), nMin, nMax);
    vec4 result = mix(curr, prev, blend);
    imageStore(u_currHistory, coord, result);
}
