#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube uEnvironmentMap;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray uOutIrradianceMap;

const float PI = 3.14159265358979323846;

vec3 getCubeDirection(vec2 uv, uint face) {
    vec3 dir;
    switch(face) {
        case 0: dir = vec3( 1.0, -uv.y, -uv.x); break; // +X
        case 1: dir = vec3(-1.0, -uv.y,  uv.x); break; // -X
        case 2: dir = vec3( uv.x,  1.0,  uv.y); break; // +Y
        case 3: dir = vec3( uv.x, -1.0, -uv.y); break; // -Y
        case 4: dir = vec3( uv.x, -uv.y,  1.0); break; // +Z
        case 5: dir = vec3(-uv.x, -uv.y, -1.0); break; // -Z
    }
    return normalize(dir);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    uint face = gl_GlobalInvocationID.z;
    ivec2 size = imageSize(uOutIrradianceMap).xy;

    if (pixel.x >= size.x || pixel.y >= size.y || face >= 6) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 st = uv * 2.0 - 1.0;

    vec3 normal = getCubeDirection(st, face);
    vec3 irradiance = vec3(0.0);

    // Tangent space basis from normal
    vec3 up = abs(normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
    vec3 right = normalize(cross(up, normal));
    up = cross(normal, right);

    const float sampleDelta = 0.05; // 0.05 rad delta (~64 x 32 samples = ~2000 texture fetches)
    float nrSamples = 0.0;

    for (float phi = 0.0; phi < 2.0 * PI; phi += sampleDelta) {
        for (float theta = 0.0; theta < 0.5 * PI; theta += sampleDelta) {
            // Spherical to cartesian in tangent space
            vec3 tangentSample = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
            // Tangent space to world space
            vec3 sampleVec = tangentSample.x * right + tangentSample.y * up + tangentSample.z * normal;

            irradiance += texture(uEnvironmentMap, sampleVec).rgb * cos(theta) * sin(theta);
            nrSamples += 1.0;
        }
    }

    irradiance = PI * irradiance * (1.0 / max(nrSamples, 1.0));
    imageStore(uOutIrradianceMap, ivec3(pixel, face), vec4(irradiance, 1.0));
}
